{
  "redfish-mcp": {
    "command": "uvx",
    "args": [
      "--from",
      "git+https://github.com/togethercomputer/mcp-common@main#subdirectory=servers/redfish-mcp",
      "redfish-mcp"
    ],
    "env": {
      "REDFISH_USER": "${REDFISH_USER}",
      "REDFISH_PASSWORD": "${REDFISH_PASSWORD}",
      "VERIFY_SSL": "${VERIFY_SSL:-true}"
    }
  }
}
