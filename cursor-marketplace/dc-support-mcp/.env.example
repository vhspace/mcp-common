# dc-support-mcp — example environment configuration
#
# Copy to `.env` and set YOUR OWN values. Every secret may be a literal OR a
# 1Password reference `op://<vault>/<item>/<field>`, resolved at runtime via
# the mcp-common credential chain (`op` + op-forward Touch ID, keyctl cache).
# This file commits only VARIABLE NAMES and example `op://` REFERENCES — never
# real secret values. The `op://` strings below are pointers, not secrets.
#
# Per-user / non-shared: each person owns their own 1Password items (personal
# `Employee` vault) and points these vars at their own `op://` refs. The
# `op://` field label depends on the item category:
#   - LOGIN item          → /username, /password
#   - API_CREDENTIAL item → /credential
#
# 1Password tagging convention (tag YOUR personal items — see
# ../../docs/AGENT_CONVENTIONS.md#per-user-credentials-host-url-defaults-and-1password-tagging):
#   - common tag:        dc-support-mcp
#   - per-service tags:  atlassian, linear, rtb, grafana, netbox
#   - TAG, don't rename, SHARED items (e.g. `Together IPA` powers IPA + Grafana).
#   - REUSE one item across servers for the same secret (e.g. NETBOX_TOKEN).
#
# Validate setup:  uv run mcp-plugin-gen doctor .   &&   uv run mcp-common-doctor
# op-forward gotcha: `op` colorizes even `--format json`; set NO_COLOR=1 when
# scripting around it or the JSON won't parse.

# ── Vendor portal secrets ────────────────────────────────────────────────
# ORI Industries portal (Atlassian) — LOGIN item
ORI_PORTAL_USERNAME="op://Employee/Atlassian Ori support portal/username"
ORI_PORTAL_PASSWORD="op://Employee/Atlassian Ori support portal/password"

# Hypertec / 5C portal (Atlassian) — LOGIN item
HYPERTEC_PORTAL_USERNAME="op://Employee/Hypertec cloud support together/username"
HYPERTEC_PORTAL_PASSWORD="op://Employee/Hypertec cloud support together/password"

# IREN portal (Freshdesk) — LOGIN item (browser fallback path)
IREN_PORTAL_USERNAME="op://Employee/Together IREN/username"
IREN_PORTAL_PASSWORD="op://Employee/Together IREN/password"

# IREN Freshdesk REST API key — optional, preferred over the browser fallback.
# Not yet provisioned in 1Password; browser fallback is used today. Example
# ref shown for when it is set up (API_CREDENTIAL item → /credential):
# IREN_FRESHDESK_API_KEY="op://Employee/Together IREN Freshdesk/credential"

# ── Internal-ops secrets (VPN-gated) ─────────────────────────────────────
# Repair Ticket Bridge (RTB) — API_CREDENTIAL item → /credential.
# (NOTE: the 1Password item title currently reads "Repair Ticke Bridge".)
RTB_API_KEY="op://Employee/Repair Ticke Bridge/credential"

# Linear (triage listing / assignment) — API_CREDENTIAL item → /credential
LINEAR_API_KEY="op://Employee/Linear/credential"

# Grafana Alertmanager proxy auth — SHARED `Together IPA` LOGIN item (also
# powers IPA). Tag, don't rename.
O11Y_GRAFANA_USERNAME="op://Employee/Together IPA/username"
O11Y_GRAFANA_PASSWORD="op://Employee/Together IPA/password"

# NetBox token — REUSE netbox-mcp's existing item rather than duplicating it.
NETBOX_TOKEN="op://Employee/Together - Netbox/NETBOX_TOKEN"

# ── Non-secret routing config ────────────────────────────────────────────
# RTB → Linear team key (plain value; leave unset for the default routing).
# RTB_LINEAR_TEAM_KEY=""

# ── Host URLs: non-secret, default-but-overridable ───────────────────────
# Each line shows the BUILT-IN DEFAULT. Leave unset to use it; the common case
# needs none of these. Override only to point at a different environment — a
# literal, or (since they use the same resolver) an `op://` ref.
# ORI_BASE_URL="https://oriindustries.atlassian.net"
# HYPERTEC_BASE_URL="https://hypertec-cloud.atlassian.net"
# IREN_BASE_URL="https://support.iren.com"
# IREN_FRESHDESK_URL="https://iren.freshdesk.com"
# RTB_BASE_URL="https://rtb.together.ai"
# NETBOX_URL="https://i.together.ai"
# GRAFANA_AM_PROXY_BASE="https://monitoring-admin.internal.together.ai/grafana/api/alertmanager"  # UNCERTAIN — verify live, see constants.py
