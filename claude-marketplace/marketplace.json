{
  "schemaVersion": 1,
  "entries": [
    {
      "schemaVersion": 1,
      "name": "awx-mcp",
      "description": "MCP server for Ansible AWX / Automation Controller job management and orchestration",
      "version": "1.5.0",
      "repository": "https://github.com/togethercomputer/mcp-common",
      "license": "Apache-2.0",
      "author": {
        "name": "Together AI"
      },
      "keywords": [
        "ansible",
        "automation",
        "awx",
        "mcp",
        "tower"
      ],
      "categories": [
        "automation",
        "operations"
      ],
      "tags": [
        "ansible",
        "awx",
        "jobs",
        "orchestration"
      ],
      "mcpServer": {
        "command": "uvx",
        "args": [
          "--from",
          "git+https://github.com/togethercomputer/mcp-common@main#subdirectory=servers/awx-mcp",
          "awx-mcp"
        ],
        "env": {
          "AWX_HOST": "${AWX_HOST}",
          "AWX_TOKEN": "${AWX_TOKEN}",
          "MCP_HTTP_ACCESS_TOKEN": "${MCP_HTTP_ACCESS_TOKEN}"
        }
      },
      "pluginPath": ".claude-plugin/plugin.json"
    },
    {
      "schemaVersion": 1,
      "name": "dc-support-mcp",
      "description": "MCP server for datacenter vendor support portals -- ticket management for ORI Industries and IREN",
      "version": "1.16.0",
      "repository": "https://github.com/togethercomputer/mcp-common",
      "license": "Apache-2.0",
      "author": {
        "name": "Together AI"
      },
      "keywords": [
        "datacenter",
        "mcp",
        "support",
        "tickets",
        "vendor"
      ],
      "categories": [
        "infrastructure",
        "operations"
      ],
      "tags": [
        "datacenter",
        "support",
        "tickets",
        "vendor"
      ],
      "mcpServer": {
        "command": "uvx",
        "args": [
          "--from",
          "git+https://github.com/togethercomputer/mcp-common@main#subdirectory=servers/dc-support-mcp",
          "dc-support-mcp"
        ],
        "env": {
          "GRAFANA_AM_PROXY_BASE": "${GRAFANA_AM_PROXY_BASE:-https://monitoring-admin.internal.together.ai/grafana/api/alertmanager}",
          "HYPERTEC_BASE_URL": "${HYPERTEC_BASE_URL:-https://hypertec-cloud.atlassian.net}",
          "HYPERTEC_PORTAL_PASSWORD": "${HYPERTEC_PORTAL_PASSWORD}",
          "HYPERTEC_PORTAL_USERNAME": "${HYPERTEC_PORTAL_USERNAME}",
          "IREN_BASE_URL": "${IREN_BASE_URL:-https://support.iren.com}",
          "IREN_FRESHDESK_API_KEY": "${IREN_FRESHDESK_API_KEY}",
          "IREN_FRESHDESK_URL": "${IREN_FRESHDESK_URL:-https://iren.freshdesk.com}",
          "IREN_PORTAL_PASSWORD": "${IREN_PORTAL_PASSWORD}",
          "IREN_PORTAL_USERNAME": "${IREN_PORTAL_USERNAME}",
          "LINEAR_API_KEY": "${LINEAR_API_KEY}",
          "NETBOX_TOKEN": "${NETBOX_TOKEN}",
          "NETBOX_URL": "${NETBOX_URL:-https://i.together.ai}",
          "O11Y_GRAFANA_PASSWORD": "${O11Y_GRAFANA_PASSWORD}",
          "O11Y_GRAFANA_USERNAME": "${O11Y_GRAFANA_USERNAME}",
          "ORI_BASE_URL": "${ORI_BASE_URL:-https://oriindustries.atlassian.net}",
          "ORI_PORTAL_PASSWORD": "${ORI_PORTAL_PASSWORD}",
          "ORI_PORTAL_USERNAME": "${ORI_PORTAL_USERNAME}",
          "RTB_API_KEY": "${RTB_API_KEY}",
          "RTB_BASE_URL": "${RTB_BASE_URL:-https://rtb.together.ai}",
          "RTB_LINEAR_TEAM_KEY": "${RTB_LINEAR_TEAM_KEY:-}"
        }
      },
      "pluginPath": ".claude-plugin/plugin.json"
    },
    {
      "schemaVersion": 1,
      "name": "mcp-network",
      "description": "Read-only MCP access to Together AI network switches (initially the ORI-TX NVIDIA Cumulus Linux fabric)",
      "version": "1.1.3",
      "repository": "https://github.com/togethercomputer/mcp-common",
      "license": "Apache-2.0",
      "author": {
        "name": "Together AI"
      },
      "keywords": [
        "cumulus",
        "mcp",
        "network",
        "switches"
      ],
      "categories": [
        "infrastructure",
        "networking",
        "operations"
      ],
      "tags": [
        "cumulus",
        "mcp",
        "network",
        "switches"
      ],
      "mcpServer": {
        "command": "uvx",
        "args": [
          "--from",
          "git+https://github.com/togethercomputer/mcp-common@main#subdirectory=servers/mcp-network",
          "mcp-network"
        ],
        "env": {
          "ORI_NETWORK_PASSWORD": "${ORI_NETWORK_PASSWORD}",
          "ORI_NETWORK_USER": "${ORI_NETWORK_USER}"
        }
      },
      "pluginPath": ".claude-plugin/plugin.json"
    },
    {
      "schemaVersion": 1,
      "name": "netbox-mcp",
      "description": "A read-only MCP server and CLI for querying NetBox infrastructure data",
      "version": "2.23.0",
      "repository": "https://github.com/togethercomputer/mcp-common",
      "license": "Apache-2.0",
      "author": {
        "name": "Together AI"
      },
      "keywords": [
        "dcim",
        "infrastructure",
        "mcp",
        "netbox"
      ],
      "categories": [
        "infrastructure",
        "operations"
      ],
      "tags": [
        "cmdb",
        "dcim",
        "inventory",
        "netbox"
      ],
      "mcpServer": {
        "command": "uvx",
        "args": [
          "--from",
          "git+https://github.com/togethercomputer/mcp-common@main#subdirectory=servers/netbox-mcp",
          "netbox-mcp"
        ],
        "env": {
          "NETBOX_TOKEN": "${NETBOX_TOKEN}",
          "NETBOX_URL": "${NETBOX_URL}",
          "VERIFY_SSL": "${VERIFY_SSL:-true}"
        }
      },
      "pluginPath": ".claude-plugin/plugin.json"
    }
  ]
}
