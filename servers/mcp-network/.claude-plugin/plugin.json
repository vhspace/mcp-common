{
  "name": "mcp-network",
  "description": "Read-only MCP access to Together AI network switches (initially the ORI-TX NVIDIA Cumulus Linux fabric)",
  "version": "1.1.3",
  "author": {
    "name": "Together AI"
  },
  "repository": "https://github.com/togethercomputer/mcp-common",
  "license": "Apache-2.0",
  "keywords": [
    "mcp",
    "network",
    "cumulus",
    "switches"
  ],
  "mcpServers": {
    "mcp-network": {
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/togethercomputer/mcp-common@main#subdirectory=servers/mcp-network",
        "mcp-network"
      ],
      "env": {
        "ORI_NETWORK_USER": "${ORI_NETWORK_USER}",
        "ORI_NETWORK_PASSWORD": "${ORI_NETWORK_PASSWORD}"
      }
    }
  }
}
