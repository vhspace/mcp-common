{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "awx-mcp": {
      "type": "local",
      "command": [
        "uvx",
        "--from",
        "git+https://github.com/togethercomputer/mcp-common@main#subdirectory=servers/awx-mcp",
        "awx-mcp"
      ],
      "environment": {
        "AWX_HOST": "${AWX_HOST}",
        "AWX_TOKEN": "${AWX_TOKEN}",
        "MCP_HTTP_ACCESS_TOKEN": "${MCP_HTTP_ACCESS_TOKEN}"
      },
      "enabled": true
    }
  }
}
